# Client-side. Only publishable keys belong here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
EXPO_PUBLIC_RESTAURANT_SLUG=your-restaurant-slug
EXPO_PUBLIC_SITE_URL=https://your-site.example
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Server-side: set these via `supabase secrets set`, NOT in EXPO_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@example.com
# DISPATCH_SECRET=
